--- !u!114 &702854106
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 702854105}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4342012cd48d120499363d0a30c9efa0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TheSpaceBetween.Runtime::TheSpaceBetween.TutorialGuide
  player: {fileID: 731025988}
  swap: {fileID: 731025989}
  goal: {fileID: 1911453943}
  controlsUntil: {fileID: 677500597}
  introText: Reach the end of the facility. Each room has one way through.
  introSeconds: 7
  endText: End of the Final Playtest. Thank you.
  signs:
  - text: {fileID: 1869173207}
    content: '{Move}  move      {Run}  run

      {Jump}  jump

      {Use}  use     
      {Restart}  restart the room'
  - text: {fileID: 1323726284}
    content: '{Aim}  aim        {Swap}  swap places'
  hints:
  - name: Barrier
    text: Low barrier. {Jump} jumps over it.
    room: {fileID: 61722603}
    showNear: {fileID: 631640773}
    nearRadius: 7
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 108793239}
    security: 0
  - name: Glass
    text: Glass stops you, not a swap. Aim at something beyond it with {Aim} and
      press {Swap} to trade places.
    room: {fileID: 1701302857}
    showNear: {fileID: 344501887}
    nearRadius: 5
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 1373149248}
    security: 0
  - name: Wall run
    text: Hold {Run} and {Right} and run into the curve to run up the wall.
    room: {fileID: 784899997}
    showNear: {fileID: 0}
    nearRadius: 0
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 2
    doneAt: {fileID: 1335119961}
    security: 0
  - name: Wall jump
    text: On a wall, {Jump} jumps to the opposite wall. Steer back with {Left} or
      {Right}.
    room: {fileID: 992769848}
    showNear: {fileID: 0}
    nearRadius: 0
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 2
    doneAt: {fileID: 1057746298}
    security: 0
  - name: Seen
    text: Seen. Wait outside its light, or {Restart} restarts the room.
    room: {fileID: 752362955}
    showNear: {fileID: 0}
    nearRadius: 0
    onlyWhileAlarmed: {fileID: 1459520512}
    doneRule: 1
    doneAt: {fileID: 1693114170}
    security: 1
  - name: Camera
    text: This camera seals the exit while it can see you.
    room: {fileID: 752362955}
    showNear: {fileID: 0}
    nearRadius: 0
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 1693114170}
    security: 1
  - name: Pressure pad
    text: A pressure pad holds a door open only while something stands on it.
    room: {fileID: 1961162451}
    showNear: {fileID: 0}
    nearRadius: 0
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 1251539535}
    security: 0
  - name: Slide
    text: '{Slide} slides under the low hood.'
    room: {fileID: 1538513279}
    showNear: {fileID: 1930730751}
    nearRadius: 7
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 1800319895}
    security: 0
  - name: Failing floor
    text: The floor is failing. Keep running.
    room: {fileID: 1538513279}
    showNear: {fileID: 0}
    nearRadius: 0
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 1267170582}
    security: 0
  - name: Mid-air swap
    text: A swap works in mid-jump too.
    room: {fileID: 928793405}
    showNear: {fileID: 1198617690}
    nearRadius: 8
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 394393714}
    security: 0
  - name: Elevator
    text: Stand on the pad to ride the platform up.
    room: {fileID: 928793405}
    showNear: {fileID: 542321095}
    nearRadius: 5
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 2
    doneAt: {fileID: 1516197582}
    security: 0
  - name: Double Jump
    text: Press {Jump} again after a swap to jump in mid-air.
    room: {fileID: 170478803}
    showNear: {fileID: 700058553}
    nearRadius: 14
    onlyWhileAlarmed: {fileID: 0}
    doneRule: 1
    doneAt: {fileID: 1989523360}
    security: 0
  hintFontSize: 30
  endFontSize: 40
  fadeSeconds: 0.25
  panelColor: {r: 0.145, g: 0.176, b: 0.196, a: 0.78}
  textColor: {r: 0.702, g: 0.71, b: 0.678, a: 1}
  keyColor: {r: 0.902, g: 0.894, b: 0.863, a: 1}
  swapColor: {r: 0.659, g: 0.863, b: 0.878, a: 1}
  securityColor: {r: 0.827, g: 0.631, b: 0.302, a: 1}
